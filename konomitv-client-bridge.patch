         // Document Picture-in-Picture API がサポートされていない場合は何もしない
         if (('documentPictureInPicture' in window) === false) {
+            // iOS ラッパーアプリ内では、WebKit 独自の PiP への橋渡しだけを足す (ローカル改造・案)
+            // 標準の requestPictureInPicture() は iOS の WebKit には無いため、
+            // DPlayer の PiP ボタンが呼ぶ先を webkitSetPresentationMode() で補う
+            if (navigator.userAgent.includes('KonomiTV-iOS')) {
+                const install_webkit_pip_bridge = (video: HTMLVideoElement) => {
+                    const video_any = video as any;
+                    if (typeof video_any.webkitSupportsPresentationMode !== 'function'
+                        || video_any.webkitSupportsPresentationMode('picture-in-picture') === false
+                        || typeof video_any.webkitSetPresentationMode !== 'function') {
+                        return;
+                    }
+                    video_any.requestPictureInPicture = async () => {
+                        // すでに PiP 中なら通常表示に戻し、そうでなければ PiP を開始する
+                        const next_mode = video_any.webkitPresentationMode === 'picture-in-picture' ? 'inline' : 'picture-in-picture';
+                        video_any.webkitSetPresentationMode(next_mode);
+                        return {} as PictureInPictureWindow;  // 呼び出し側は戻り値を使わないため形だけ合わせる
+                    };
+                };
+                install_webkit_pip_bridge(this.player.video);
+                // 画質切り替え後は映像要素が差し替わるため、付け直す
+                this.player.on('quality_end', () => {
+                    if (this.player && this.player.video) {
+                        install_webkit_pip_bridge(this.player.video);
+                    }
+                });
+                console.log('[DocumentPiPManager] Initialized. (WebKit Picture-in-Picture bridge for iOS app.)');
+                return;
+            }
             console.log('[DocumentPiPManager] Initialized. (Document Picture-in-Picture API is not supported.)');
             return;
         }
